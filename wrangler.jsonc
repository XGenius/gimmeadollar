// Serves the static site from Cloudflare. `npx wrangler deploy` uploads the
// files and attaches both hostnames as custom domains, which also creates
// their DNS records in the gimmeadollar.net zone.
//
// Only /api/* runs the Worker script (the millionaire meter); everything else
// is served straight from the static assets.
// Secrets (set with `wrangler secret put`): STRIPE_WEBHOOK_SECRET, RESEND_API_KEY.
// Until RESEND_API_KEY is set, Notify Me signups wait in the Durable Object;
// the cron below syncs them to Resend once it is.
{
  "name": "gimmeadollar",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Stripe Payment Links whose payments count on the meter, comma separated:
    // the current one (buy.stripe.com/dRm7sL5vrbIL0SJdjLdEs01, $1 each, any quantity)
    // and the original fixed $1 link (buy.stripe.com/6oU3cv2jf14758Z7ZrdEs00).
    "PAYMENT_LINK_IDS": "plink_1UQXUyE1YOfYuzo1vyFlzS4U,plink_1UQCa5E1YOfYuzo1zKTSDw4B",
    // SHA-256 of the random token in the Stripe webhook endpoint's URL.
    "HOOK_TOKEN_SHA256": "08c7d38812a3f2730dd07da33b26b7bde5e67768ebeabbcde6cc9f3896dd8427"
  },
  "durable_objects": {
    "bindings": [{ "name": "METER", "class_name": "Meter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Meter"] }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "gimmeadollar.net", "custom_domain": true },
    { "pattern": "www.gimmeadollar.net", "custom_domain": true }
  ]
}
